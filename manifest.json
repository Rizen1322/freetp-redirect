{
  "manifest_version": 3,
  "name": "FreeTP Redirect + Cleaner",
  "version": "1.1",
  "description": "Редирект freetp.ru → freetp.org",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://freetp.ru/*",
    "*://freetp.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://freetp.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
